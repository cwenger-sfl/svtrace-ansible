[project]
org='seapath'
name='inventories'

[build]
command='check_yaml'
flavors='configure_tests run_tests'
bind_docker_sock='true'

[configure_tests]
command='ansible-playbook -i inventories/qcom.yml playbooks/configure_latency_tests.yaml'

[run_tests]
command='ansible-playbook -i inventories/qcom.yml playbooks/run_latency_tests.yaml'
